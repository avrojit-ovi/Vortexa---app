<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theme; this only paints the window before the
         first frame so there is no white flash. -->
    <style name="Theme.Vortexa" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/vortexa_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
